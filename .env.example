# ---- Database ----
DATABASE_URL=postgresql://auditsphere:auditsphere@localhost:5432/auditsphere?schema=public

# ---- API ----
API_PORT=4000
SWAGGER_ENABLED=true
API_BASE_URL=http://localhost:4000
WEB_BASE_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000
JWT_ACCESS_SECRET=change-me-32-chars-minimum-access-secret
JWT_REFRESH_SECRET=change-me-32-chars-minimum-refresh-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
COOKIE_SECURE=false
# off | audit | all. Client-data production with local accounts must use all.
MFA_ENFORCEMENT=audit
ENCRYPTION_KEY=change-me-64-hex-chars-0000000000000000000000000000000000000000000000

# ---- Microsoft Entra ID (OIDC) ----
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
ENTRA_REDIRECT_URI=http://localhost:4000/api/v1/auth/entra/callback

# ---- Document storage ----
# local = files under .local-storage/ served by the API (development)
# s3    = S3 compatible: AWS S3, MinIO, Azure Blob via gateway (presigned URLs)
STORAGE_DRIVER=local
# Required in production when using local storage. Use a dedicated data volume.
LOCAL_STORAGE_DIR=
RUN_JOBS=false
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=auditsphere-documents
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_FORCE_PATH_STYLE=true
# Local development skips scanning. Production must set this true and provide
# a reachable ClamAV-compatible clamd service.
MALWARE_SCAN_REQUIRED=false
MALWARE_SCANNER=clamav
CLAMAV_HOST=
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_MS=60000
# Windows production can use Microsoft Defender instead of clamd. Leave blank
# to auto-discover the newest installed MpCmdRun.exe platform directory.
DEFENDER_MPCMDRUN_PATH=

# ---- AI (OpenAI-compatible; point at Azure OpenAI, OpenAI, Ollama, vLLM, etc.) ----
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4o
AI_ENABLED=false

# ---- Email ----
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM="BDO AuditSphere <no-reply@auditsphere.local>"

# ---- Web ----
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# ---- One-time production bootstrap (used only by pnpm db:bootstrap-admin) ----
# BOOTSTRAP_TENANT_SLUG=your-organisation
# BOOTSTRAP_TENANT_NAME=Your Organisation
# BOOTSTRAP_ADMIN_EMAIL=admin@example.com
# BOOTSTRAP_ADMIN_NAME=Platform Administrator
# BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-unique-14-character-minimum-password
# BOOTSTRAP_CURRENCY=KES
# BOOTSTRAP_TIMEZONE=Africa/Nairobi
