// BDO AuditSphere - canonical data model.
// Every business table carries tenantId for tenant isolation. Row Level Security
// policies are applied in the rls migration; the API additionally scopes every
// query through a tenant-aware Prisma client extension.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum UserStatus {
  INVITED
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

enum RoleKey {
  GLOBAL_ADMIN
  AUDIT_PARTNER
  CHIEF_AUDIT_EXECUTIVE
  AUDIT_MANAGER
  SENIOR_AUDITOR
  JUNIOR_AUDITOR
  BUSINESS_OWNER
  MANAGEMENT_REVIEWER
  AUDIT_COMMITTEE_VIEWER
}

enum AuthProvider {
  LOCAL
  ENTRA_ID
}

enum EntityType {
  LEGAL_ENTITY
  BUSINESS_UNIT
  COUNTRY
  DEPARTMENT
  PROCESS
  SYSTEM
  PRODUCT
  THIRD_PARTY
}

enum RiskRating {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum RiskStatus {
  ACTIVE
  MONITORING
  RETIRED
}

enum RiskVelocity {
  SLOW
  MODERATE
  FAST
  IMMEDIATE
}

enum ControlType {
  PREVENTIVE
  DETECTIVE
  CORRECTIVE
  DIRECTIVE
}

enum ControlNature {
  MANUAL
  AUTOMATED
  IT_DEPENDENT_MANUAL
}

enum ControlFrequency {
  CONTINUOUS
  DAILY
  WEEKLY
  MONTHLY
  QUARTERLY
  SEMI_ANNUAL
  ANNUAL
  EVENT_DRIVEN
}

enum ControlEffectiveness {
  NOT_TESTED
  EFFECTIVE
  PARTIALLY_EFFECTIVE
  INEFFECTIVE
}

enum ControlTestType {
  DESIGN
  OPERATING
}

enum ControlTestResult {
  NOT_STARTED
  IN_PROGRESS
  PASS
  PASS_WITH_EXCEPTIONS
  FAIL
}

enum PlanStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  ACTIVE
  ARCHIVED
}

enum PlanItemStatus {
  PROPOSED
  PLANNED
  IN_PROGRESS
  COMPLETED
  DEFERRED
  CANCELLED
}

enum PlanItemSource {
  RISK_BASED
  MANAGEMENT_REQUEST
  REGULATORY
  FOLLOW_UP
  AUDIT_COMMITTEE
  ROTATIONAL
}

enum EngagementType {
  OPERATIONAL
  FINANCIAL
  COMPLIANCE
  IT
  INVESTIGATION
  ADVISORY
  FOLLOW_UP
  INTEGRATED
  INTERNAL_AUDIT
}

enum EngagementStage {
  PLANNING
  RISK_ASSESSMENT
  PROGRAMME
  FIELDWORK
  REVIEW
  REPORTING
  FOLLOW_UP
  CLOSED
}

enum EngagementStatus {
  ACTIVE
  ON_HOLD
  CANCELLED
  COMPLETED
}

enum EngagementRole {
  PARTNER
  MANAGER
  LEAD
  SENIOR
  JUNIOR
  REVIEWER
  SPECIALIST
  OBSERVER
}

enum AuditOpinion {
  SATISFACTORY
  NEEDS_IMPROVEMENT
  UNSATISFACTORY
  NOT_RATED
}

enum ProgramStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  IN_PROGRESS
  COMPLETED
}

enum StepStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  NOT_APPLICABLE
}

enum WorkpaperStatus {
  DRAFT
  PREPARED
  IN_REVIEW
  REVIEW_NOTES_OPEN
  REVIEWED
  SIGNED_OFF
}

enum ReviewNoteStatus {
  OPEN
  ADDRESSED
  CLEARED
}

enum ReviewNotePriority {
  LOW
  NORMAL
  HIGH
}

enum ReviewDecision {
  APPROVED
  CHANGES_REQUESTED
  REJECTED
}

enum ReviewLevel {
  PREPARER
  FIRST
  SECOND
  PARTNER
  QUALITY
}

enum EvidenceType {
  DOCUMENT
  SCREENSHOT
  SYSTEM_EXTRACT
  INTERVIEW_NOTE
  OBSERVATION
  RECALCULATION
  CONFIRMATION
  EMAIL
  PHOTO
  VOICE_NOTE
}

enum DocumentClassification {
  PUBLIC
  INTERNAL
  CONFIDENTIAL
  RESTRICTED
}

enum FindingSeverity {
