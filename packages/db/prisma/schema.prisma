  VALIDATION
  CLOSED
  RISK_ACCEPTED
}

enum RecommendationStatus {
  PROPOSED
  AGREED
  IN_PROGRESS
  IMPLEMENTED
  VALIDATED
  NOT_IMPLEMENTED
  SUPERSEDED
