}

enum RiskSignalStatus {
  NEW
  REVIEWED
  LINKED
  DISMISSED
}

enum MonitoringAlertStatus {
  OPEN
  INVESTIGATING
  CONFIRMED
  FALSE_POSITIVE
  ESCALATED
}

enum ConnectorType {
  DATABASE
  REST_API
  FILE_UPLOAD
  SAP
  ORACLE
  DYNAMICS_365
