# ============================================================================
# BDO AuditSphere - PILOT environment (Docker Compose on one Windows machine,
# shared over the office network). Read docs/pilot-runbook.md before use.
#
# How to use:  copy this file to .env in the repository root (back up the
# existing .env first), then fill in the four <<...>> placeholders below.
#
#   1. Replace every  PILOT-PC  with your machine's network name or fixed IP
#      (for example  audit-laptop  or  192.168.10.25). Keep the http:// and :3000.
#   2. Generate the three secrets (commands in the runbook, section 3).
#   3. Choose a strong database password.
#   4. Point PILOT_DATA_DIR at a folder OUTSIDE OneDrive (default D:/auditsphere-data).
#
# This template contains placeholders and may be committed. Keep the populated
# .env copy private; never commit it or paste it into chat/email.
# ============================================================================

# ---- Database (container) ----
# The containers build their own DATABASE_URL from POSTGRES_* below.
POSTGRES_USER=auditsphere
POSTGRES_PASSWORD=<<STRONG-DATABASE-PASSWORD>>
POSTGRES_DB=auditsphere
# Publish PostgreSQL on this machine only (not on the network); needed for pnpm db:seed.
POSTGRES_PORT=127.0.0.1:5432

# ---- Database (host, used only by `pnpm db:seed` run from this machine) ----
# Must use the same password as POSTGRES_PASSWORD.
DATABASE_URL=postgresql://auditsphere:<<STRONG-DATABASE-PASSWORD>>@localhost:5432/auditsphere?schema=public

# ---- Public addresses (what users type in the browser) ----
# Everything is served through the web app on port 3000; the API is reached via
# the built-in /api rewrite, so only port 3000 needs to be open on the firewall.
API_BASE_URL=http://PILOT-PC:3000
WEB_BASE_URL=http://PILOT-PC:3000
CORS_ORIGINS=http://PILOT-PC:3000,http://localhost:3000
NEXT_PUBLIC_API_URL=/api/v1

# ---- Secrets (generate fresh values; runbook section 3) ----
JWT_ACCESS_SECRET=<<GENERATE-48-BYTE-BASE64>>
JWT_REFRESH_SECRET=<<GENERATE-48-BYTE-BASE64-DIFFERENT-FROM-ACCESS>>
ENCRYPTION_KEY=<<GENERATE-64-HEX-CHARS>>
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
# Plain HTTP inside the office network: keep false. Set true only behind HTTPS.
COOKIE_SECURE=false

# ---- Microsoft sign-in: off for the pilot (local accounts only) ----
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
ENTRA_REDIRECT_URI=http://PILOT-PC:3000/api/v1/auth/entra/callback

# ---- Document storage ----
# The pilot override file (infra/docker/docker-compose.pilot.yml) stores uploaded
# documents on this machine's disk under PILOT_DATA_DIR/storage, shared by the API
# and the worker. Use forward slashes. Folder must exist and be outside OneDrive.
PILOT_DATA_DIR=D:/auditsphere-data
# MinIO still runs inside the stack but is not used or exposed; give it non-default
# credentials anyway.
S3_ACCESS_KEY=auditsphere-minio
S3_SECRET_KEY=<<ANY-STRONG-PASSWORD>>
S3_BUCKET=auditsphere-documents
S3_REGION=us-east-1

# ---- AI Sphere ----
# false = built-in local drafting mode (what the presentation screenshots show).
# Only set true once an approved provider key exists; then fill the three lines.
AI_ENABLED=false
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4o

# ---- Email ----
# The stack routes all email to Mailpit (a local inbox at http://localhost:8025 on
# this machine); nothing leaves the machine. To send real notifications through
# Office 365, see runbook section 11.
SMTP_FROM="BDO AuditSphere <no-reply@auditsphere.local>"
