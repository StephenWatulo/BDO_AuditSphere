<service>
  <id>AuditSphere.Caddy</id>
  <name>AuditSphere HTTPS Edge</name>
  <description>Caddy TLS termination and reverse proxy for AuditSphere.</description>
  <executable>C:\Windows\System32\WindowsPowerShell\v1.0\powershell.exe</executable>
  <arguments>-NoLogo -NoProfile -NonInteractive -ExecutionPolicy Bypass -File "__RUNNER__" -Service Caddy -AppRoot "__APP_ROOT__" -EnvFile "__ENV_FILE__" -RuntimeRoot "__RUNTIME_ROOT__"</arguments>
  <workingdirectory>__RUNTIME_ROOT__\caddy</workingdirectory>
  <serviceaccount><username>NT AUTHORITY\LocalService</username></serviceaccount>
  <depend>AuditSphere.Web</depend>
  <startmode>Automatic</startmode>
  <delayedAutoStart>true</delayedAutoStart>
  <stoptimeout>30 sec</stoptimeout>
  <onfailure action="restart" delay="10 sec" />
  <onfailure action="restart" delay="30 sec" />
  <resetfailure>1 hour</resetfailure>
  <logpath>__LOG_ROOT__</logpath>
  <log mode="roll-by-size-time"><sizeThreshold>10240</sizeThreshold><pattern>yyyyMMdd</pattern><autoRollAtTime>00:00:00</autoRollAtTime><zipOlderThanNumDays>7</zipOlderThanNumDays><keepFiles>14</keepFiles></log>
</service>

