# AuditSphere Windows Server production environment. Copy to a protected location
# such as C:\AuditSphere\config\production.env and replace every CHANGE_ME value.
NODE_ENV=production
LOG_LEVEL=info

DATABASE_URL=postgresql://auditsphere_owner:CHANGE_ME_DB_PASSWORD@127.0.0.1:5432/auditsphere?schema=public&connection_limit=20

API_PORT=4000
API_HOST=127.0.0.1
SWAGGER_ENABLED=false
API_BASE_URL=https://auditsphere.example.com
WEB_BASE_URL=https://auditsphere.example.com
CORS_ORIGINS=https://auditsphere.example.com
JWT_ACCESS_SECRET=CHANGE_ME_RANDOM_64_CHARS
JWT_REFRESH_SECRET=CHANGE_ME_DIFFERENT_RANDOM_64_CHARS
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=12h
COOKIE_SECURE=true
MFA_ENFORCEMENT=all
ENCRYPTION_KEY=CHANGE_ME_EXACTLY_64_HEX_CHARS
RUN_JOBS=false

ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
ENTRA_REDIRECT_URI=https://auditsphere.example.com/api/v1/auth/entra/callback

STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=D:\AuditSphereData\documents
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=auditsphere-documents
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_FORCE_PATH_STYLE=true

MALWARE_SCAN_REQUIRED=true
MALWARE_SCANNER=defender
CLAMAV_HOST=
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_MS=120000
DEFENDER_MPCMDRUN_PATH=

AI_ENABLED=false
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=

SMTP_HOST=CHANGE_ME_REQUIRED_SMTP_HOST
SMTP_PORT=587
SMTP_USER=CHANGE_ME_REQUIRED_SMTP_USER
SMTP_PASS=CHANGE_ME_REQUIRED_SMTP_PASSWORD
SMTP_FROM=BDO AuditSphere <no-reply@example.com>

# Used by the Windows service runner and backup scripts; ignored by the API.
DOMAIN=auditsphere.example.com
ACME_EMAIL=platform-owner@example.com
API_INTERNAL_URL=http://127.0.0.1:4000
PORT=3000
HOSTNAME=127.0.0.1
BACKUP_ROOT=\\backup-server\auditsphere-production
BACKUP_RETENTION_DAYS=35

